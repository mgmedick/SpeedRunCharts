@using Microsoft.Extensions.Configuration
@using System.Security.Claims
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment hostingEnv
@inject IConfiguration Configuration

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    @*<meta name="viewport" content="width=device-width, initial-scale=1.0" />*@
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />    
    <title>@ViewData["Title"] - SpeedRunCharts</title>
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/dist/fonts/pie-chart.svg")" />

    <environment include="Development">
        <link rel="stylesheet" href="~/dist/vendor.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/dist/style.min.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/dist/vendor.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/dist/style.min.css" asp-append-version="true" />
    </environment>
    @RenderSection("Styles", required: false)
</head>
<body data-bs-theme="@(User.Identity.IsAuthenticated ? User.FindFirst("theme")?.Value : Context.Request.Cookies["theme"] ?? (Configuration.GetSection("SiteSettings").GetSection("DefaultTheme").Value))">
    <div id="vue-app">
        @Html.AntiForgeryToken()
        <header>
            <div id="toastcontainer" class="toast-container position-fixed p-3 bottom-0 end-0"> 
                <div id="successtoast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <span class="msg-text"></span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>   
                <div id="errortoast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <span class="msg-text"></span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>                                    
            </div>   
        </header>
        <navbar :isauth="@Json.Serialize(User.Identity.IsAuthenticated)" :userid="'@User.FindFirstValue(ClaimTypes.NameIdentifier)'" :username="'@User.FindFirstValue(ClaimTypes.Name)'" :isdarktheme="@Json.Serialize((User.Identity.IsAuthenticated ? User.FindFirst("theme")?.Value : Context.Request.Cookies["theme"] ?? Configuration.GetSection("SiteSettings").GetSection("DefaultTheme").Value) == "dark")"></navbar>        
        <div>
            @RenderBody()
        </div>
        <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 mt-5">
            <div class="col-md-4 d-flex align-items-center">
                <span class="mb-3 mb-md-0 text-body-secondary px-3">© 2024 Company, Inc</span>
            </div>
        </footer>     
    </div>
    <environment include="Development">
        <script src="@Url.Content("~/dist/master.min.js")" asp-append-version="true"></script>
        <script src="@Url.Content("~/dist/vendor.min.js")" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="@Url.Content("~/dist/master.min.js")" asp-append-version="true"></script>
        <script src="@Url.Content("~/dist/vendor.min.js")" asp-append-version="true"></script>
    </environment>
    @RenderSection("Scripts", required: false)
</body>
</html>
