
@using System.Text.Json;
@using System.Security.Claims

@model SpeedRunApp.Model.ViewModels.UserSettingsViewModel

<div class="container-lg p-0">
    @if (!User.Identity.IsAuthenticated)
    {
        <div><span>Please login to view user settings</span></div>
    }
    else 
    {
        <h5 class="m-0 font-weight-bold m-0">@User.FindFirst(ClaimTypes.Name).Value</h5>
        <div>
            <user-settings :usersettingsvm="@JsonSerializer.Serialize(Model, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase})"></user-settings>
        </div>    
    }
</div>




























